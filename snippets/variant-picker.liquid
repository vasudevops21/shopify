{%- comment -%}
  Native Shopify variant picker. Renders each product option as touch-friendly
  pill buttons. The "Size" option gets larger, dedicated styling per spec.
  Accepts: product, product_form_id
{%- endcomment -%}
<variant-picker class="variant-picker" data-product-url="{{ product.url }}" data-section="{{ section.id }}">
  {%- for option in product.options_with_values -%}
    <div class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
      <div class="variant-picker__option-header">
        <span class="variant-picker__option-name">{{ option.name }}</span>
        {%- if option.name == 'Size' -%}
          <button type="button" class="variant-picker__size-guide-link" data-open-size-guide>
            {{ 'products.product.size_guide' | t }}
          </button>
        {%- endif -%}
      </div>
      <div class="variant-picker__values" role="radiogroup" aria-label="{{ option.name }}">
        {%- for value in option.values -%}
          {%- liquid
            assign is_selected = false
            if option.selected_value == value
              assign is_selected = true
            endif
          -%}
          <input
            type="radio"
            id="{{ product_form_id }}-option-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
            name="option-{{ forloop.parentloop.index0 }}"
            value="{{ value | escape }}"
            {% if is_selected %}checked{% endif %}
            class="variant-picker__radio visually-hidden"
          >
          <label
            for="{{ product_form_id }}-option-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
            class="variant-picker__pill {% if option.name == 'Size' %}variant-picker__pill--size{% endif %}"
            data-value="{{ value | escape }}"
          >
            {{ value }}
          </label>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

  <script type="application/json" data-variant-json>
    {{ product.variants | json }}
  </script>
</variant-picker>
