{%- comment -%} Accepts: qty (number), name, min, id_prefix {%- endcomment -%}
<div class="quantity-input">
  <button type="button" class="quantity-input__btn" data-quantity-decrease aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
  <input
    type="number"
    class="quantity-input__field"
    name="{{ name | default: 'quantity' }}"
    value="{{ qty | default: 1 }}"
    min="{{ min | default: 0 }}"
    inputmode="numeric"
    data-quantity-field
    aria-label="{{ 'products.product.quantity' | t }}"
  >
  <button type="button" class="quantity-input__btn" data-quantity-increase aria-label="{{ 'products.product.quantity_increase' | t }}">&plus;</button>
</div>
