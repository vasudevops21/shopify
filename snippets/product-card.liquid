{%- comment -%}
  Accepts: product, lazy_image (boolean, optional)
{%- endcomment -%}
{%- liquid
  assign featured_image = product.featured_media.preview_image | default: product.featured_image
  assign hover_image = product.media[1].preview_image
  assign loading = lazy_image | default: true
-%}
<div class="product-card" data-product-card>
  <a href="{{ product.url }}" class="product-card__media-link" aria-label="{{ product.title | escape }}">
    <div class="product-card__media">
      {%- if featured_image -%}
        <img
          srcset="{{ featured_image | image_url: width: 300 }} 300w,
                  {{ featured_image | image_url: width: 450 }} 450w,
                  {{ featured_image | image_url: width: 600 }} 600w,
                  {{ featured_image | image_url: width: 800 }} 800w"
          sizes="(min-width: 990px) 25vw, 50vw"
          src="{{ featured_image | image_url: width: 600 }}"
          alt="{{ featured_image.alt | default: product.title | escape }}"
          width="{{ featured_image.width }}"
          height="{{ featured_image.height }}"
          class="product-card__image product-card__image--main"
          {% if loading %}loading="lazy"{% endif %}
        >
        {%- if hover_image -%}
          <img
            srcset="{{ hover_image | image_url: width: 600 }} 600w"
            src="{{ hover_image | image_url: width: 600 }}"
            alt=""
            width="{{ hover_image.width }}"
            height="{{ hover_image.height }}"
            class="product-card__image product-card__image--hover"
            loading="lazy"
            aria-hidden="true"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
      {%- endif -%}

      {%- liquid
        assign compare = product.compare_at_price_min
        assign price = product.price_min
      -%}
      {%- if compare > price -%}
        {%- assign badge_percent = compare | minus: price | times: 100.0 | divided_by: compare | round -%}
        <span class="product-card__badge">{{ 'products.product.price.discount_off' | t: percent: badge_percent }}</span>
      {%- endif -%}

      {%- unless product.available -%}
        <span class="product-card__badge product-card__badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
      {%- endunless -%}
    </div>
  </a>

  <button
    type="button"
    class="product-card__wishlist"
    data-wishlist-toggle
    data-product-id="{{ product.id }}"
    aria-pressed="false"
    aria-label="{{ 'products.product.add_to_wishlist' | t }}"
  >
    {% render 'icon-wishlist' %}
  </button>

  <div class="product-card__info">
    <p class="product-card__set-label">{{ 'products.product.three_piece_set' | t }}</p>
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    {% render 'star-rating', product: product %}
    {% render 'price', product: product %}

    {%- if product.has_only_default_variant and product.selected_or_first_available_variant.available -%}
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" name="add" class="button button--primary product-card__add-btn">
          {{ 'products.product.add_to_cart' | t }}
        </button>
      {%- endform -%}
    {%- else -%}
      <a href="{{ product.url }}" class="button button--secondary product-card__add-btn">
        {%- if product.available -%}
          {{ 'products.product.select_options' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
</div>
