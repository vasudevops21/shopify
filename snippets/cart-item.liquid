{%- comment -%} Accepts: item (cart line item), item_index {%- endcomment -%}
<div class="cart-item" data-cart-item data-line="{{ item_index }}">
  <a href="{{ item.url }}" class="cart-item__image-link">
    {%- if item.image -%}
      <img
        src="{{ item.image | image_url: width: 200 }}"
        alt="{{ item.image.alt | escape }}"
        width="100"
        height="{{ 100 | divided_by: item.image.aspect_ratio }}"
        loading="lazy"
        class="cart-item__image"
      >
    {%- endif -%}
  </a>
  <div class="cart-item__details">
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__variant">{{ item.variant.title }}</p>
    {%- endunless -%}
    <div class="cart-item__price-row">
      {% render 'price', product: item.product, variant: item.variant, show_badge: false %}
    </div>
    <div class="cart-item__footer">
      <input type="hidden" name="updates[]" data-cart-quantity-input value="{{ item.quantity }}" data-line="{{ item_index }}">
      <div class="quantity-input" data-cart-quantity-wrapper data-line="{{ item_index }}">
        <button type="button" class="quantity-input__btn" data-cart-quantity-decrease aria-label="{{ 'products.product.quantity_decrease' | t }}">&minus;</button>
        <span class="quantity-input__value" data-cart-quantity-value>{{ item.quantity }}</span>
        <button type="button" class="quantity-input__btn" data-cart-quantity-increase aria-label="{{ 'products.product.quantity_increase' | t }}">&plus;</button>
      </div>
      <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ item_index }}" aria-label="{{ 'cart.general.remove' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>
  </div>
  <div class="cart-item__line-total">{{ item.final_line_price | money }}</div>
</div>
