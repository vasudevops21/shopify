<section class="account-page page-width account-page--narrow">
  <h1 class="account-page__title">{{ 'customer.activate_account.title' | t }}</h1>
  <p>{{ 'customer.activate_account.subtext' | t }}</p>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <p class="account-page__error">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div class="account-page__field">
      <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
      <input type="password" name="customer[password]" id="ActivatePassword" required>
    </div>
    <div class="account-page__field">
      <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" required>
    </div>
    <button type="submit" name="accept" class="button button--primary">{{ 'customer.activate_account.submit' | t }}</button>
    <button type="submit" name="decline" class="button button--outline">{{ 'customer.activate_account.decline' | t }}</button>
  {%- endform -%}
</section>
