<section class="account-page page-width">
  <h1 class="account-page__title">{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p>{{ 'customer.order.date' | t: date: order.created_at | date: '%B %d, %Y' }}</p>

  <table class="account-page__orders-table">
    <thead>
      <tr>
        <th>{{ 'customer.order.product' | t }}</th>
        <th>{{ 'customer.order.sku' | t }}</th>
        <th>{{ 'customer.order.price' | t }}</th>
        <th>{{ 'customer.order.quantity' | t }}</th>
        <th>{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td><a href="{{ line_item.product.url }}">{{ line_item.title }}</a></td>
          <td>{{ line_item.sku }}</td>
          <td>{{ line_item.original_price | money }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <div class="account-page__totals">
    <p>{{ 'customer.order.subtotal' | t }}: {{ order.line_items_subtotal_price | money }}</p>
    <p>{{ 'customer.order.total' | t }}: {{ order.total_price | money }}</p>
  </div>

  <a href="{{ routes.account_url }}" class="button button--outline">{{ 'customer.order.back' | t }}</a>
</section>
