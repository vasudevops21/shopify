<section class="account-page page-width">
  <div class="account-page__header">
    <h1 class="account-page__title">{{ 'customer.account.title' | t }}</h1>
    {%- form 'customer_logout' -%}
      <button type="submit" class="account-page__logout">{{ 'customer.log_out' | t }}</button>
    {%- endform -%}
  </div>

  <div class="account-page__section">
    <h2>{{ 'customer.orders.title' | t }}</h2>
    {%- if customer.orders.size > 0 -%}
      <table class="account-page__orders-table">
        <thead>
          <tr>
            <th>{{ 'customer.orders.order_number' | t }}</th>
            <th>{{ 'customer.orders.date' | t }}</th>
            <th>{{ 'customer.orders.payment_status' | t }}</th>
            <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
            <th>{{ 'customer.orders.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders -%}
            <tr>
              <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
              <td>{{ order.created_at | date: '%B %d, %Y' }}</td>
              <td>{{ order.financial_status_label }}</td>
              <td>{{ order.fulfillment_status_label }}</td>
              <td>{{ order.total_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- else -%}
      <p>{{ 'customer.orders.none' | t }}</p>
    {%- endif -%}
  </div>

  <div class="account-page__section">
    <h2>{{ 'customer.account.details' | t }}</h2>
    <p>{{ customer.name }}<br>{{ customer.email }}</p>
    <a href="{{ routes.account_addresses_url }}" class="button button--outline">{{ 'customer.account.view_addresses' | t }}</a>
  </div>
</section>
