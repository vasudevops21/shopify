<section class="hero-banner" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="hero-banner__media">
    {%- if section.settings.image != blank -%}
      <img
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                {{ section.settings.image | image_url: width: 1100 }} 1100w,
                {{ section.settings.image | image_url: width: 1500 }} 1500w,
                {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        src="{{ section.settings.image | image_url: width: 1500 }}"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        class="hero-banner__image"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__image hero-banner__placeholder' }}
    {%- endif -%}
    <div class="hero-banner__overlay"></div>
  </div>

  <div class="hero-banner__content page-width">
    <div class="hero-banner__text hero-banner__text--{{ section.settings.text_position }}">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="hero-banner__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
      <div class="hero-banner__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link }}" class="button button--primary">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="button button--outline">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay darkness", "min": 0, "max": 60, "step": 5, "default": 15, "unit": "%" },
    { "type": "select", "id": "text_position", "label": "Text position", "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elegance in Every Layer." },
    { "type": "textarea", "id": "subtext", "label": "Supporting text", "default": "Discover beautifully coordinated 3-piece Kurti Sets designed for effortless everyday elegance." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "SHOP 3-PIECE SETS" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "NEW ARRIVALS" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
