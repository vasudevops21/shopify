<section class="why-choose-us page-width">
  <div class="section-heading section-heading--center">
    {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
  </div>
  <div class="why-choose-us__grid">
    {%- for block in section.blocks -%}
      <div class="why-choose-us__item" {{ block.shopify_attributes }}>
        <span class="why-choose-us__icon">{{ block.settings.icon }}</span>
        <h3 class="why-choose-us__title">{{ block.settings.title }}</h3>
        <p class="why-choose-us__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Why choose us",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Choose Vasthi Couture" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "✨" },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Designs" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Beautifully coordinated 3-piece sets." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "reason", "settings": { "icon": "✨", "title": "Premium Designs", "text": "Beautifully coordinated 3-piece sets." } },
      { "type": "reason", "settings": { "icon": "🌸", "title": "Comfort Meets Style", "text": "Designed for everyday comfort." } },
      { "type": "reason", "settings": { "icon": "💎", "title": "Affordable Luxury", "text": "Premium fashion at accessible prices." } },
      { "type": "reason", "settings": { "icon": "🛍️", "title": "Easy Shopping", "text": "Simple browsing and secure checkout." } },
      { "type": "reason", "settings": { "icon": "🔄", "title": "Easy Returns", "text": "10 days return / replacement." } }
    ]
  },
  "presets": [
    { "name": "Why choose us" }
  ]
}
{% endschema %}
