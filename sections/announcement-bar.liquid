<div class="announcement-bar" {% if section.settings.enable %}data-autoplay="{{ section.settings.autoplay_speed }}"{% endif %}>
  <div class="announcement-bar__track">
    {%- for block in section.blocks -%}
      <div class="announcement-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        <span>{{ block.settings.text }}</span>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Auto-rotate messages",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Rotate speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "🚚 FREE SHIPPING ON ORDERS ABOVE ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "🚚 FREE SHIPPING ON ORDERS ABOVE ₹999" } },
      { "type": "message", "settings": { "text": "🔄 10 DAYS EASY RETURN / REPLACEMENT" } }
    ]
  }
}
{% endschema %}
