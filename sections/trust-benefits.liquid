<section class="trust-benefits page-width">
  <div class="trust-benefits__grid">
    {%- for block in section.blocks -%}
      <div class="trust-benefits__item" {{ block.shopify_attributes }}>
        <span class="trust-benefits__icon">{{ block.settings.icon }}</span>
        <h3 class="trust-benefits__title">{{ block.settings.title }}</h3>
        <p class="trust-benefits__subtitle">{{ block.settings.subtitle }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust benefits",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🚚" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Orders above ₹999" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "benefit", "settings": { "icon": "🚚", "title": "Free Shipping", "subtitle": "Orders above ₹999" } },
      { "type": "benefit", "settings": { "icon": "🔄", "title": "10 Days Easy Return", "subtitle": "Return / replacement support" } },
      { "type": "benefit", "settings": { "icon": "🔒", "title": "Secure Payments", "subtitle": "Safe checkout" } },
      { "type": "benefit", "settings": { "icon": "💬", "title": "Customer Support", "subtitle": "We're here to help" } }
    ]
  },
  "presets": [
    { "name": "Trust benefits" }
  ]
}
{% endschema %}
