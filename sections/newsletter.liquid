<section class="newsletter">
  <div class="newsletter__inner page-width">
    {%- if section.settings.heading != blank -%}<h2 class="newsletter__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="newsletter__subtext">{{ section.settings.subtext }}</p>{%- endif -%}

    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__field-row">
        <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.email_placeholder' | t }}</label>
        <input
          type="email"
          id="NewsletterEmail"
          name="contact[email]"
          class="newsletter__input"
          placeholder="{{ 'newsletter.email_placeholder' | t }}"
          required
          {% if customer %}value="{{ customer.email }}"{% endif %}
        >
        <button type="submit" class="button button--primary newsletter__submit">{{ 'newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="newsletter__error">{{ form.errors.messages['email'] }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Vasthi Couture Family" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Get first access to new arrivals, special offers and fashion updates." }
  ]
}
{% endschema %}
