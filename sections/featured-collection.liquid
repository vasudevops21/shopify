<section class="featured-collection page-width" id="shopify-section-{{ section.id }}">
  <div class="section-heading section-heading--{{ section.settings.heading_align }}">
    {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="section-heading__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- liquid
    assign coll = section.settings.collection
    assign limit = section.settings.products_to_show
  -%}

  {%- if coll != blank and coll.products.size > 0 -%}
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col product-grid--mobile-{{ section.settings.columns_mobile }}-col" data-product-grid>
      {%- for product in coll.products limit: limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
    {%- if section.settings.show_view_all -%}
      <div class="featured-collection__view-all">
        <a href="{{ coll.url }}" class="button button--outline">{{ 'sections.featured_collection.view_all' | t }}</a>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col product-grid--mobile-{{ section.settings.columns_mobile }}-col">
      {%- for i in (1..limit) -%}
        <div class="product-card product-card--placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
          <div class="product-card__info">
            <p class="product-card__set-label">{{ 'products.product.three_piece_set' | t }}</p>
            <h3 class="product-card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Collection showcase",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [
        { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
      ], "default": "center" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "options": [
        { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
      ], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [
        { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
      ], "default": "2" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true }
  ],
  "presets": [
    { "name": "Collection showcase" }
  ]
}
{% endschema %}
